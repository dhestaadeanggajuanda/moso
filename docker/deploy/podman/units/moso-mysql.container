# MySQL website @SLUG@. Tag 8.4 ikut mendapat patch; podman-auto-update menarik patch baru
# (didahului backup, lihat install-instance.sh) dan mengembalikan versi lama bila gagal sehat.
[Unit]
Description=moso @SLUG@ - MySQL
After=moso-network.service
Wants=moso-network.service

[Container]
Image=docker.io/library/mysql:8.4
ContainerName=@SLUG@-mysql
AutoUpdate=registry
Network=moso.network
NetworkAlias=mysql
Volume=moso-mysql.volume:/var/lib/mysql
Volume=%h/moso/scripts/healthcheck-mysql.sh:/usr/local/bin/moso-healthcheck:ro,Z
EnvironmentFile=%h/moso/env/mysql.env
Exec=--character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
HealthCmd=/usr/local/bin/moso-healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=60s
Notify=healthy
NoNewPrivileges=true
LogDriver=journald
LogOpt=tag=@SLUG@-mysql

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
