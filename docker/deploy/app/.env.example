# .env server aplikasi moso (dibaca docker compose dan container app/worker/scheduler).
# Salin ke docker/deploy/app/.env lalu isi. Jangan pernah commit berkas .env.
# Panduan: docs/DEPLOY.md

APP_NAME="Portal Dinas"
# production untuk server produksi. Server development: staging (issuer SSO http:// diizinkan, TrustHosts tetap aktif).
APP_ENV=production
APP_DEBUG=false
# Buat dengan: docker compose -f docker/deploy/app/compose.yaml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://portal.dinas.example.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Port lokal yang diteruskan reverse proxy (HTTPS) ke container app.
APP_HTTP_PORT=8000
# Reverse proxy di host meneruskan dari gateway jaringan Docker. Isi subnet Docker
# (cek: docker network inspect moso-app_default) atau IP proxy. Lihat config/trustedproxy.php.
TRUSTED_PROXIES=172.16.0.0/12
# Host tambahan selain host APP_URL (cocok persis), dipisah koma.
TRUSTED_HOSTS=

# Log aplikasi ke stderr (docker logs); log audit tetap ke berkas di volume storage-logs.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

BCRYPT_ROUNDS=12

# MySQL di compose ini. DB_HOST/DB_PORT diatur compose.
DB_CONNECTION=mysql
DB_DATABASE=moso
DB_USERNAME=moso
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis di compose ini untuk sesi, cache, dan antrean. REDIS_HOST/REDIS_PORT diatur compose.
REDIS_CLIENT=phpredis
REDIS_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# RustFS di server terpisah (HTTPS).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=moso-public
AWS_PRIVATE_BUCKET=moso-private
AWS_ENDPOINT=https://s3.dinas.example.go.id
AWS_URL=https://s3.dinas.example.go.id/moso-public
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="noreply@dinas.example.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Header keamanan
CSP_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_ENABLED=true
SECURITY_ENFORCE_2FA=true

# SSO Keycloak di server terpisah (docker/deploy/keycloak). Lihat docs/SSO-ROADMAP.md.
SSO_ENABLED=true
SSO_PROVIDER=pemkot
SSO_LABEL="SSO Pemerintah Kota"
SSO_ISSUER=https://sso.dinas.example.go.id/realms/moso
SSO_CLIENT_ID=moso-portal
# Harus sama dengan MOSO_SSO_CLIENT_SECRET di .env server Keycloak.
SSO_CLIENT_SECRET=
SSO_MFA_AMR=mfa,otp,hwk,swk,sms,face,fpt
SSO_MFA_ACR=
SSO_LOCAL_LOGIN=true

# Media Center Kota Singkawang
MEDIA_CENTER_BASE_URL=https://mediacenter.singkawangkota.go.id

# SSR halaman publik (container ssr). INERTIA_SSR_URL diatur compose.
INERTIA_SSR_ENABLED=true

# Tema yang dikompilasi ke image (build arg).
VITE_THEMES=TemaModern

# Akun Super Admin awal (php artisan db:seed --class=SuperAdminSeeder). Kosongkan setelah dipakai.
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
