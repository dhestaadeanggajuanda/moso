# .env server Keycloak moso. Salin ke docker/deploy/keycloak/.env lalu isi.
# Jangan pernah commit berkas .env. Panduan: docs/DEPLOY.md

# URL publik Keycloak lewat reverse proxy HTTPS.
KC_HOSTNAME=https://sso.dinas.example.go.id
KEYCLOAK_HTTP_PORT=8080

KC_ADMIN_USER=admin
# Kata sandi admin awal (master realm). Ganti/aktifkan 2FA admin setelah login pertama.
KC_ADMIN_PASSWORD=

KC_DB_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
KC_DB_ROOT_PASSWORD=

# Realm import: URL portal moso (tanpa garis miring di akhir) dan kredensial klien.
# MOSO_SSO_CLIENT_SECRET harus sama dengan SSO_CLIENT_SECRET di .env server aplikasi (openssl rand -hex 32).
MOSO_APP_URL=https://portal.dinas.example.go.id
MOSO_SSO_CLIENT_ID=moso-portal
MOSO_SSO_CLIENT_SECRET=
