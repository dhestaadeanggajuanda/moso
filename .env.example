APP_NAME="Portal Dinas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
# Port php artisan serve / composer run dev (8000 sering dipakai aplikasi lain)
SERVER_PORT=8010

APP_TIMEZONE=Asia/Pontianak
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 dari docker/compose.yaml
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=moso
DB_USERNAME=moso
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit dari docker/compose.yaml (UI: http://127.0.0.1:8125)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1125
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@portal-dinas.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8125

# Object storage S3 self-hosted (RustFS atau Garage). Lihat docs/STORAGE-S3.md.
# RustFS lokal: endpoint :9100, region us-east-1
# Garage lokal: endpoint :3900, region garage, AWS_URL=http://moso-public.web.garage.localhost:3902
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://127.0.0.1:9100
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=moso-public
AWS_URL=http://127.0.0.1:9100/moso-public
AWS_PRIVATE_BUCKET=moso-private
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101

# Hanya untuk profil Garage (openssl rand -hex 32)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Wajib 2FA untuk Super Admin & Approver sebelum masuk panel admin
SECURITY_ENFORCE_2FA=true

# Produksi di belakang reverse proxy/load balancer: IP atau CIDR proxy, dipisah koma
# (lihat config/trustedproxy.php). Kosong = header X-Forwarded-* tidak dipercaya.
TRUSTED_PROXIES=
# Host tambahan selain host APP_URL (mis. www.dinas.singkawangkota.go.id), dipisah koma.
# Host lain dibalas 400 agar tautan reset kata sandi tidak bisa diracuni. Health check
# load balancer ke /up harus mengirim header Host publik, atau daftarkan host/IP-nya di sini.
TRUSTED_HOSTS=

# Akun awal seeder. Kosongkan setelah instalasi (lihat config/seeding.php)
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Media Center Kota Singkawang (WordPress REST API). Lihat config/mediacenter.php
MEDIA_CENTER_BASE_URL=https://mediacenter.singkawangkota.go.id

# Tema yang dikompilasi Vite (pisahkan koma; tema pertama = bawaan). Ubah lalu `npm run build`.
VITE_THEMES=TemaModern
